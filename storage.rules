rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Global default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isActiveAdmin() {
      return request.auth != null
        && firestore.get(/databases/ai-studio-5ebcf76e-59b5-4690-aeb9-9f28e6f8f4b6/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isSafeImageUpload(fileName) {
      return request.auth != null
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches('^image/(jpeg|png|webp)$')
        && fileName.matches('^[a-zA-Z0-9._-]{1,160}\\.(jpg|jpeg|png|webp)$');
    }

    function isSafeVideoUpload(fileName) {
      return request.auth != null
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches('^video/(mp4|webm|quicktime)$')
        && fileName.matches('^[a-zA-Z0-9._-]{1,160}\\.(mp4|webm|mov)$');
    }

    // Legacy & quick Food Menu photos: public read, admin-only write/delete
    match /food_menu/{fileName} {
      allow read: if true;
      allow create, update: if isSafeImageUpload(fileName) && isActiveAdmin();
      allow delete: if isActiveAdmin();
    }

    // Legacy & quick Cake Menu photos: public read, admin-only write/delete
    match /cake_menu/{fileName} {
      allow read: if true;
      allow create, update: if isSafeImageUpload(fileName) && isActiveAdmin();
      allow delete: if isActiveAdmin();
    }

    // Permanent Media Library (originals, compressed web derivatives, and videos)
    match /media_library/originals/{fileName} {
      allow read: if true;
      allow create, update: if isSafeImageUpload(fileName) && isActiveAdmin();
      allow delete: if isActiveAdmin();
    }

    match /media_library/derivatives/{fileName} {
      allow read: if true;
      allow create, update: if isSafeImageUpload(fileName) && isActiveAdmin();
      allow delete: if isActiveAdmin();
    }

    match /media_library/videos/{fileName} {
      allow read: if true;
      allow create, update: if isSafeVideoUpload(fileName) && isActiveAdmin();
      allow delete: if isActiveAdmin();
    }

    // Website section media (hero banners, cakes banner, promo media)
    match /site_media/{fileName} {
      allow read: if true;
      allow create, update: if (isSafeImageUpload(fileName) || isSafeVideoUpload(fileName)) && isActiveAdmin();
      allow delete: if isActiveAdmin();
    }
  }
}
