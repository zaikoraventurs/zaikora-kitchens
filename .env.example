# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RAZORPAY PAYMENT GATEWAY (Server-side only — never expose secrets in frontend)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# ALLOW_RAZORPAY_TEST_IN_PROD=false


# ADMIN TWO-SECTOR KEY LOCKS (Optional server-side overrides)
ADMIN_LOCK_KEY_1=
ADMIN_LOCK_KEY_2=

# SESSION SIGNING SECRET (Required in serverless/Netlify production so sessions persist across cold starts)
SESSION_SECRET=

