        "razorpayOrderId": { "type": "string", "maxLength": 128 },
        "razorpayPaymentId": { "type": "string", "maxLength": 128 },
        "paymentVerifiedAt": { "type": "string", "format": "date-time" },
        "status": {
          "type": "string",
          "enum": [
            "PAYMENT PENDING",
            "PAYMENT FAILED",
            "PAYMENT VERIFIED",
            "PENDING ADMIN APPROVAL",
            "CONFIRMED",
            "PREPARING",
            "READY",
            "OUT FOR DELIVERY",
            "READY FOR COLLECTION",
            "DELIVERED",
            "COLLECTED",
            "REJECTED",
            "REFUND PROCESSING",
            "REFUNDED",
            "Order Placed Successfully",
            "Payment Successful / Confirmed",
            "Preparing Your Order",
            "Order Ready",
            "Out for Delivery",
            "Ready for Collection",
            "Delivered / Collected",
            "Cancelled"
          ]
        },
        "estimatedPrepMinutes": { "type": "integer" },
        "readySoonerNotice": { "type": "string", "maxLength": 200 },
        "reviewFlagged": { "type": "boolean" },
        "reviewFlagReason": { "type": "string", "maxLength": 300 },
        "suspiciousScore": { "type": "integer" },
        "adminAccepted": { "type": "boolean" },
        "adminAcceptedBy": { "type": "string", "maxLength": 128 },
        "adminAcceptedAt": { "type": "string", "format": "date-time" },
        "adminRejected": { "type": "boolean" },
        "adminRejectedBy": { "type": "string", "maxLength": 128 },
        "adminRejectedAt": { "type": "string", "format": "date-time" },
        "rejectionReason": { "type": "string", "maxLength": 300 },
        "refundId": { "type": "string", "maxLength": 128 },
        "refundStatus": {
          "type": "string",
          "enum": [
            "Refund Requested",
            "Under Investigation",
            "Refund Approved",
            "Refund Processing",
            "Refund Completed",
            "Refund Rejected"
          ]
        },
        "refundAmount": { "type": "integer" },
        "refundInitiatedAt": { "type": "string", "format": "date-time" },
        "refundCompletedAt": { "type": "string", "format": "date-time" },
        "inventoryDeducted": { "type": "boolean" },
        "inventoryDeductedAt": { "type": "string", "format": "date-time" },
        "inventoryRestored": { "type": "boolean" },
        "inventoryRestoredAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
