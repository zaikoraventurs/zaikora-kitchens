        "productId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "productType": { "type": "string", "enum": ["food", "cake"] },
        "stockMode": { "type": "string", "enum": ["unlimited", "limited"] },
        "stockUnit": { "type": "string", "minLength": 1, "maxLength": 40 },
        "previousStock": { "type": "integer" },
        "changeDelta": { "type": "integer" },
        "newStock": { "type": "integer" },
        "actionType": {
          "type": "string",
          "enum": ["manual_add", "manual_reduce", "manual_edit", "mode_change", "availability_toggle", "admin_reset", "order_deduction", "order_restore"]
        },
        "reason": { "type": "string", "maxLength": 240 },
        "orderId": { "type": "string", "maxLength": 128 },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["historyId", "productId", "productName", "productType", "stockMode", "stockUnit", "previousStock", "changeDelta", "newStock", "actionType", "actorUid", "createdAt"]
    },
    "CheckoutCharge": {
      "title": "CheckoutCharge",
      "description": "Admin-managed checkout fee or charge (fixed INR or percentage, optional free override, enable/disable toggle).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 240 },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["fixed", "percentage"] },
        "appliesOn": { "type": "string", "enum": ["all", "delivery_only"] },
        "enabled": { "type": "boolean" },
        "displayOrder": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "amount", "type", "appliesOn", "enabled", "displayOrder", "createdAt", "updatedAt"]
    }
  },
