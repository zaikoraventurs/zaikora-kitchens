        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "phone", "name", "createdAt", "updatedAt"]
    },
    "Address": {
      "title": "Address",
      "description": "Customer saved delivery address inside or outside Brigade Eldorado.",
